{
  "name": "tensorlake",
  "version": "0.5.125",
  "description": "TensorLake SDK for applications, sandboxes, and cloud services",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tensorlake-deploy": "./bin/tensorlake-deploy.cjs",
    "tensorlake-create-sandbox-image": "./bin/tensorlake-create-sandbox-image.js",
    "tensorlake-import-sandbox-image": "./bin/tensorlake-import-sandbox-image.js",
    "function-executor": "./bin/function-executor.js",
    "tensorlake-typescript-function-runner": "./bin/tensorlake-typescript-function-runner.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./applications": {
      "import": {
        "types": "./dist/applications/index.d.ts",
        "default": "./dist/applications/index.js"
      },
      "require": {
        "types": "./dist/applications/index.d.cts",
        "default": "./dist/applications/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/native",
    "bin",
    "lib",
    "runtime"
  ],
  "scripts": {
    "build:sdk": "tsup",
    "build:runtime": "node ./scripts/build-function-executor-capsule.mjs && node ./scripts/build-typescript-function-runner-capsule.mjs && node ./scripts/check-package-compatibility.mjs",
    "build:native": "node ./scripts/build-native.mjs",
    "build": "npm run build:sdk && npm run build:native && npm run build:runtime",
    "check:proto": "node ./scripts/check-function-executor-proto.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:function-executor": "vitest run tests/function-executor.test.ts tests/function-executor-protocol.test.ts",
    "test:function-agent": "vitest run tests/function-agent.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "tensorlake",
    "sandbox",
    "cloud",
    "sdk",
    "applications"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tensorlakeai/tensorlake",
    "directory": "typescript"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.8.0",
    "ajv": "^8.17.1",
    "fflate": "^0.8.2",
    "google-proto-files": "^5.0.2",
    "nanoid": "^3.3.18",
    "undici": "8.3.0",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "@tensorlake/native-darwin-arm64": "0.5.125",
    "@tensorlake/native-linux-arm64-gnu": "0.5.125",
    "@tensorlake/native-linux-arm64-musl": "0.5.125",
    "@tensorlake/native-linux-x64-gnu": "0.5.125",
    "@tensorlake/native-linux-x64-musl": "0.5.125",
    "@tensorlake/native-win32-x64": "0.5.125"
  }
}
