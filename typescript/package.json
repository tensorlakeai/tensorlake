{
  "name": "@tensorlakeai/tensorlake",
  "version": "0.6.0",
  "description": "TensorLake SDK for sandboxes and cloud services",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tensorlake-create-sandbox-image": "./bin/tensorlake-create-sandbox-image.js",
    "tensorlake-import-sandbox-image": "./bin/tensorlake-import-sandbox-image.js"
  },
  "exports": {
    "./internal/native-worker": "./dist/native-worker.cjs",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "!dist/native",
    "bin",
    "lib"
  ],
  "scripts": {
    "build:sdk": "tsup",
    "build:native": "node ./scripts/build-native.mjs",
    "build": "npm run build:sdk && npm run build:native && npm run check:package",
    "check:package": "node ./scripts/check-package-compatibility.mjs",
    "check:install-scripts": "node ./scripts/check-no-install-scripts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:native-sandbox": "node ./scripts/test-native-sandbox.mjs",
    "test:native-command-output-limit": "node ./scripts/test-native-command-output-limit.mjs",
    "test:native-tunnel": "node ./scripts/test-native-tunnel.mjs",
    "test:native-cloud": "node ./scripts/test-native-cloud.mjs",
    "test:nextjs": "node ./scripts/test-nextjs.mjs",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "tensorlake",
    "sandbox",
    "cloud",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tensorlakeai/tensorlake",
    "directory": "typescript"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "@tensorlakeai/native-darwin-arm64": "0.6.0",
    "@tensorlakeai/native-linux-arm64-gnu": "0.6.0",
    "@tensorlakeai/native-linux-arm64-musl": "0.6.0",
    "@tensorlakeai/native-linux-x64-gnu": "0.6.0",
    "@tensorlakeai/native-linux-x64-musl": "0.6.0",
    "@tensorlakeai/native-win32-x64": "0.6.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
  }
}
